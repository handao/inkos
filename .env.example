# InkOS Environment Configuration (Docker Production)
# Copy to .env and fill in your values

# JWT Secret (REQUIRED - generate with: openssl rand -base64 64)
JWT_SECRET=your-jwt-secret-here

# MySQL
MYSQL_ROOT_PASSWORD=inkos_prod_pass
MYSQL_PASSWORD=inkos_pass

# SMTP Mail
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=noreply@inkos.app

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4567,https://inkos.app
